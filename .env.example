# Prompt Studio server configuration

DEEPSEEK_API_KEY=your_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.95
DEEPSEEK_PRESENCE_PENALTY=0.25

# Optional provider keys. Model cards may also use encrypted server-side keys.
OPENAI_API_KEY=your_api_key
ANTHROPIC_API_KEY=your_api_key
CLOUDSWAY_API_KEY=your_api_key
OPENROUTER_API_KEY=your_api_key

# Use a stable random secret in production. Do not commit the real value.
PROMPT_STUDIO_ENCRYPTION_KEY=replace_with_a_stable_secret
